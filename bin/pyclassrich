import click
import yaml
import json
import pandas as pd
import matplotlib.pyplot as plt

from pyclassrich.utils import *
from pyclassrich.models import *

from pyclassrich.stats import *
from pyclassrich.gnps import Proteosafe

@click.group()
def class_enrich():
    pass

@class_enrich.command()
@click.option("--taskid",
              default='',
              help="Optional NAP taskid")
@click.option("--param",
              default='',
              help="Optional parameter file")
@click.option("--out",
              help="Output file name")
def classification(taskid, param, out):
    if taskid=='' and param!='':
        with open(param, 'r') as f:
            params = yaml.safe_load(f)
        nap_taskid = params['nap_taskid']
    elif taskid=='':
        raise ValueError("Provide either param or taskid")

    annotated = classify(nap_taskid)
    annotated.to_csv(out, sep='\t', index=None)

@class_enrich.command()
@click.option("--ann",
              help=".tsv annotation table")
@click.option("--param",
              help="Parameter file")
@click.option("--out",
              help="Output file name")
def univariate_analysis(ann, param, out):
    with open(param, 'r') as f:
        params = yaml.safe_load(f)

    taskid = params['nap_taskid']
    ndict = Proteosafe(taskid, 'NAP')
    ndict.get_nap()
    tabgnps = ndict.tabgnps

    gnps = Proteosafe(params['gnps_taskid'], 'FBMN')
    gnps.get_gnps()
    feat = gnps.feat
    meta = gnps.meta

    annotated = pd.read_csv(ann, sep='\t')
    df = univariate(annotated, tabgnps,
                    params, feat, meta)

    df.to_csv(out, sep='\t', index=None)

@class_enrich.command()
@click.option("--uni",
              default='',
              help="Optional univariate table file")
@click.option("--param",
              help="Parameter file")
@click.option("--cfield",
              default='class',
              help="Class prefix: class, superclass or subclass")
@click.option("--nfield",
              default="compound names",
              help="Column containing compound identifier")
@click.option("--method",
              default="kstest",
              help="Enrichment test method: kstest or gsea")
@click.option("--sca",
              default=5,
              help="Scaling factor for plot")
@click.option("--top",
              default=0,
              help="Top classes to display")
@click.option("--out",
              help="Output directory")
def impact_plot(uni, param, cfield, nfield,
                method, sca, top, out):
    with open(param, 'r') as f:
        params = yaml.safe_load(f)

    if uni!='':
        df = pd.read_csv(uni, sep='\t')
    else:
        taskid = params['nap_taskid']
        ndict = Proteosafe(taskid, 'NAP')
        annotated = classify(ndict)
        ndict.get_nap()
        tabgnps = ndict.tabgnps

        gnps = Proteosafe(params['gnps_taskid'], 'FBMN')
        gnps.get_gnps()
        feat = gnps.feat
        meta = gnps.meta
        annotated = classify(ndict)
        df = univariate(annotated, tabgnps,
                        params, feat, meta)

    if 'canopus' in params.keys():
        print('Reading canopus...')
        canopus_df = pd.read_csv(params['canopus'], sep='\t')
        df = canopus(df, canopus_df,
                     params['canopus_id'],
                     params['canopus_class'])

    get_impact_plot(df, params, cfield=cfield, nfield=nfield,
                    method=method, scaling_factor=sca, top=top,
                    hierarchy='%s_name' % cfield, outdir=out)

@class_enrich.command()
@click.option("--uni",
              default='',
              help="Optional univariate table file")
@click.option("--param",
              help="Parameter file")
@click.option("--cfield",
              default='class',
              help="Class prefix: class, superclass or subclass")
@click.option("--nfield",
              default='compound names',
              help="Column containing compound identifier")
@click.option("--method",
              default='kstest',
              help="Enrichment test method: kstest or gsea")
@click.option("--sca",
              default=5,
              help="Scaling factor for plot")
@click.option("--out",
              help="Output directory")
def ont_graph(uni, param, cfield, nfield,
              method, sca, out):
    with open(param, 'r') as f:
        params = yaml.safe_load(f)

    if uni!='':
        df = pd.read_csv(uni, sep='\t')
    else:
        taskid = params['nap_taskid']
        ndict = Proteosafe(taskid, 'NAP')
        annotated = classify(ndict)
        ndict.get_nap()
        tabgnps = ndict.tabgnps

        gnps = Proteosafe(params['gnps_taskid'], 'FBMN')
        gnps.get_gnps()
        feat = gnps.feat
        meta = gnps.meta
        annotated = classify(ndict)
        df = univariate(annotated, tabgnps,
                        params, feat, meta)

    get_ont_graph(df, params, cfield=cfield, nfield=nfield,
                  method=method, scaling_factor=sca, outdir=out)

if __name__ == '__main__':
    class_enrich()

